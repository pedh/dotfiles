#!/bin/sh
# Chooses a pinentry and, critically, bounds how long it may wait.
#
# Routing: PINENTRY_USER_DATA is the one variable gpg forwards from the calling
# client into the pinentry environment -- everything else here comes from
# gpg-agent's own (stale) environment, GPG_TTY included. ~/.gnupg/git-gpg sets
# USE_TTY=1 only when git inherited a terminal a human can type into; anything
# else falls through to the GUI branch below.
#
# Timeouts: without one, pinentry-tty blocks forever on a pty whose reader is a
# full-screen TUI -- the failure mode that made agent-shell `git commit` hang
# until killed. The GUI budget stays under an agent's command timeout so the
# caller gets "gpg failed to sign the data" instead of a wedged tool call; the
# tty budget is longer because a human at a terminal has no such deadline.

TIMEOUT_TTY=120
TIMEOUT_GUI=60

find_command() {
  command -v "$1" 2>/dev/null
}

try_exec() {
  candidate="$1"
  timeout="$2"
  shift 2

  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" --timeout "$timeout" "$@"
  fi
}

BREW_PREFIX="$(brew --prefix 2>/dev/null || true)"
case "${PINENTRY_USER_DATA-}" in
  *USE_TTY=1*)
    try_exec "$(find_command pinentry-tty)" "$TIMEOUT_TTY" "$@"
    try_exec "$(find_command pinentry-curses)" "$TIMEOUT_TTY" "$@"
    try_exec "$(find_command pinentry)" "$TIMEOUT_TTY" "$@"
    ;;
esac

try_exec "${BREW_PREFIX:+${BREW_PREFIX}/bin/pinentry-mac}" "$TIMEOUT_GUI" "$@"
try_exec "$(find_command pinentry-mac)" "$TIMEOUT_GUI" "$@"
try_exec "$(find_command pinentry-curses)" "$TIMEOUT_GUI" "$@"
try_exec "$(find_command pinentry-tty)" "$TIMEOUT_GUI" "$@"
try_exec "$(find_command pinentry)" "$TIMEOUT_GUI" "$@"

echo "No pinentry program found" >&2
exit 127
