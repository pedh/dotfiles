#!/bin/sh
# git's gpg.program. Decides where the passphrase prompt should appear.
#
# gpg-agent spawns pinentry from the *daemon's* environment, so pinentry cannot
# tell a human's terminal from an agent's pty. PINENTRY_USER_DATA is the one
# variable gpg forwards from the calling client into the pinentry environment,
# so the decision has to be made here and passed along.
#
# Discriminator: a shell that sourced ~/.zshrc exported GPG_TTY from its own
# `tty`, so the two agree. An AI agent's tool shell inherits GPG_TTY from the
# terminal running its TUI while sitting on a pty of its own -- they disagree,
# and that pty has no reader, which is what used to hang `git commit` forever.
# Only a positive match routes to the terminal; everything else gets a GUI
# dialog, which is reachable through Screen Sharing and is time-bounded.
#
# `tty < /dev/tty` and `stat -f %d` were both tested and rejected: macOS
# ttyname() returns the literal "/dev/tty" for the former, and every /dev/ttysNNN
# shares one devfs device number for the latter -- both yield false matches.

self_tty=$(ps -o tty= -p $$ 2>/dev/null | tr -d '[:space:]')

if [ -n "$self_tty" ] && [ "$self_tty" != '??' ] && [ "${GPG_TTY-}" = "/dev/$self_tty" ]; then
  route='USE_TTY=1'
else
  route='USE_GUI=1'
fi

PINENTRY_USER_DATA="$route"
export PINENTRY_USER_DATA

# Resolve the real gpg explicitly: this machine has a GPG Suite remnant at
# /usr/local/bin/gpg alongside the Homebrew build. This script is not on PATH,
# so there is no risk of resolving to itself.
gpg=$(command -v gpg 2>/dev/null)
if [ -z "$gpg" ] || [ ! -x "$gpg" ]; then
  gpg=/opt/homebrew/bin/gpg
fi

exec "$gpg" "$@"
